{
  "name": "mutation-benchmark",
  "provider": "openrouter",
  "model": "openrouter/minimax/minimax-m2.7:free",
  "methods": [
    "full",
    "single_agent",
    "no_context",
    "no_priority"
  ],
  "mutants_per_repo": 10,
  "seed": 20260902,
  "targets": [
    {
      "github_url": "https://github.com/pallets/click",
      "label": "click",
      "include_tests": false,
      "max_files": 5,
      "ignore_globs": [
        "examples/**",
        "docs/**",
        "scripts/**",
        "benchmarks/**",
        "*.md"
      ]
    },
    {
      "github_url": "https://github.com/psf/requests",
      "label": "requests",
      "include_tests": false,
      "max_files": 5,
      "ignore_globs": [
        "examples/**",
        "docs/**",
        "scripts/**",
        "benchmarks/**",
        "*.md"
      ]
    },
    {
      "github_url": "https://github.com/encode/httpx",
      "label": "httpx",
      "include_tests": false,
      "max_files": 5,
      "ignore_globs": [
        "examples/**",
        "docs/**",
        "scripts/**",
        "benchmarks/**",
        "*.md"
      ]
    }
  ]
}
