# Response headers for the hosted demo. Cloudflare applies these to static
# assets; `next build` copies public/ into the export, so the file lands at the
# root of out/ where Workers looks for it.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  # script-src allows 'unsafe-inline' because a Next static export streams its
  # RSC payload through inline <script> blocks; under 'self' alone the page
  # does not hydrate at all. A nonce needs a server to mint it, and hashes
  # change on every build. The concession is bounded: this page renders no
  # user-supplied HTML, so there is no injection point for an inline script to
  # come from. Everything else stays strict.
  #
  # connect-src is open on purpose: the Backend URL field exists so a visitor
  # can point the page at a RepoReviewer backend they run.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src *; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
