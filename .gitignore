.env
.env.*
!.env.example
*.pem
*.key

# --- Python ------------------------------------------------------------
__pycache__/
.pycache/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# Virtualenvs, including suffixed ones such as .venv313 or .venv-bench.
.venv
.venv*/
venv/

# --- Node / frontend ---------------------------------------------------
node_modules/
.next/
# Static export output, built by `npm run build:static` and uploaded by
