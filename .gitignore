.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ----------------------------------------------------------------
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# Not a secret: the local backend address, needed for `npm run dev` to reach a
# backend running on this machine. Real credentials live in .env, still ignored.
!frontend/.env.development
